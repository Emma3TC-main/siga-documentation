{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIGA EvidenceUploaded v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "aggregateType", "aggregateId", "occurredAt", "correlationId", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "EvidenceUploaded" },
    "schemaVersion": { "const": 1 },
    "aggregateType": { "const": "Evidence" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "producer": { "const": "evidence-service" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerType", "ownerId", "uploadedByUserId", "contentType", "sizeBytes", "sha256", "status", "uploadedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "ownerType": { "const": "MOVEMENT" },
        "ownerId": { "type": "string", "format": "uuid" },
        "uploadedByUserId": { "type": "string", "format": "uuid" },
        "contentType": { "enum": ["application/pdf", "image/jpeg", "image/png"] },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "const": "AVAILABLE" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
