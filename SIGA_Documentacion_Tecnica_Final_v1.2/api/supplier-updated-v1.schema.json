{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "SIGA SupplierUpdated v1", "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "aggregateType", "aggregateId", "occurredAt", "correlationId", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" }, "eventType": { "const": "SupplierUpdated" },
    "schemaVersion": { "const": 1 }, "aggregateType": { "const": "Supplier" },
    "aggregateId": { "type": "string", "format": "uuid" }, "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" }, "causationId": { "type": "string", "format": "uuid" },
    "producer": { "const": "catalog-service" }, "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "payload": { "type": "object", "required": ["supplier"], "properties": { "supplier": { "$ref": "#/$defs/supplier" } } },
    "supplier": { "type": "object", "required": ["id", "code", "taxId", "businessName", "active", "version"], "properties": {
      "id": { "type": "string", "format": "uuid" }, "code": { "type": "string", "maxLength": 50 },
      "taxId": { "type": "string", "maxLength": 20 }, "businessName": { "type": "string", "maxLength": 200 },
      "active": { "type": "boolean" }, "version": { "type": "integer", "minimum": 0 }
    } }
  }
}
