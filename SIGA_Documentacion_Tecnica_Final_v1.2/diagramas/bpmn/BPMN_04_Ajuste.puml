@startuml
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #4B5563
skinparam BorderColor #374151
skinparam BackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFF7D6
skinparam NoteBorderColor #A16207

title BPMN-04 — Proceso de negocio: Ajuste de inventario
|Supervisor/Encargado|
start
:Crear conteo de una ubicación;
|SIGA|
:Capturar snapshot esperado;
|Supervisor/Encargado|
:Registrar cantidades observadas;
|SIGA|
:Calcular diferencia = contado - esperado;
:Cerrar conteo sin modificar stock;
if (¿Existe diferencia y se decide regularizar?) then (sí)
 |Supervisor/Encargado|
 :Registrar explícitamente ajuste +/-\ncon motivo y Evidence del movimiento;
 |SIGA|
 :Aplicar autorización/step-up/maker-checker\ndel flujo Movement existente;
 if (¿Movimiento confirmado?) then (sí)
  :Aplicar ajuste atómico;
  :Emitir MovementConfirmed v1;
 else (no)
  :Mantener stock sin cambios;
 endif
else (no)
 :Finalizar sin ajuste;
endif
stop
@enduml
