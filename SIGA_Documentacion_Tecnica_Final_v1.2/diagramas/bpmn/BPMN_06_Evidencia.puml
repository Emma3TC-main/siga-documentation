@startuml
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #4B5563
skinparam BorderColor #374151
skinparam BackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFF7D6
skinparam NoteBorderColor #A16207

title BPMN-06 — Gestión de evidencia digital
|Usuario|
start
:Seleccionar/tomar PDF o imagen;
|Cliente|
:Prevalidar tamaño/formato y mostrar preview;
|Evidence Service|
:Validar JWT, permiso e Idempotency-Key;
:Validar acceso a owner MOVEMENT en Inventory;
:Validar metadata, MIME, magic bytes, tamaño y hash;
if (Válida?) then (sí)
 :Reservar idempotencia/evidenceId;
 |Object Storage|
 :Guardar objeto privado/versionado;
 |Evidence Service|
 :Confirmar metadata + EvidenceUploaded Outbox;
 if (¿Commit correcto?) then (sí)
  :Responder 201/replay durable;
 else (no)
  |Object Storage|
  :Eliminar exactamente el objeto nuevo;
  |Evidence Service|
  :Registrar incidente si falla compensación;
 endif
else (no)
 :Rechazar y devolver Problem Details;
endif
stop
@enduml
