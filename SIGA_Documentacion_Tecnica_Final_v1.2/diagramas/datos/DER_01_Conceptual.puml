@startuml
' --- CONFIGURACIÓN BASE Y ESPACIADO ---
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 300
skinparam nodesep 60
skinparam ranksep 70

' --- ESTILO LIMPIO PARA MODELO CONCEPTUAL ---
hide empty members
hide circle

' --- PALETA DE COLORES Y ESTILOS ---
skinparam package {
    Style rectangle
    BackgroundColor #FAFAFC
    BorderColor #4A4A4A
    BorderThickness 1.5
    FontColor #2C3E50
    FontStyle bold
    FontSize 14
}

skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #2980B9
    BorderThickness 1.5
    FontColor #2C3E50
    HeaderBackgroundColor #EBF5FB
}

skinparam arrow {
    Color #7F8C8D
    Thickness 1.5
    FontColor #606F70
    FontSize 12
}

skinparam note {
    BackgroundColor #FEF9E7
    BorderColor #F1C40F
    FontColor #7D6608
    FontSize 12
}

title <size:18><b>DER-01 — Modelo conceptual global SIGA</b></size>

' --- BOUNDED CONTEXTS ---
package "IAM" {
  entity USUARIO
  entity ROL
  entity PERMISO
  entity SESION_REFRESH
}

package "CATÁLOGO" {
  entity CATEGORIA
  entity PROVEEDOR
  entity PRODUCTO
  entity UNIDAD_MEDIDA
  entity CONVERSION_UNIDAD
}

package "INVENTARIO" {
  entity PROVEEDOR_REF
  entity PRODUCTO_REF
  entity UBICACION
  entity LOTE
  entity ACTIVO
  entity EXISTENCIA
  entity MOVIMIENTO
  entity DETALLE_MOVIMIENTO
  entity AUTORIZACION
  entity CONTEO_FISICO
  entity DETALLE_CONTEO
}

package "EVIDENCIA" {
  entity EVIDENCIA
}

package "AUDITORÍA / NOTIFICACIÓN" {
  entity AUDITORIA
  entity NOTIFICACION
}

package "REPORTING / ANALYTICS" {
  entity PROYECCION_PRODUCTO
  entity PROYECCION_INVENTARIO
  entity PROYECCION_MOVIMIENTO
  entity KPI
  entity REPORTE
}

' --- RELACIONES Y CARDINALIDADES ---
USUARIO }o--o{ ROL
ROL }o--o{ PERMISO
USUARIO ||--o{ SESION_REFRESH

CATEGORIA ||--o{ PRODUCTO
UNIDAD_MEDIDA ||--o{ PRODUCTO : almacenamiento/base
PRODUCTO ||--o{ CONVERSION_UNIDAD
UNIDAD_MEDIDA ||--o{ CONVERSION_UNIDAD

PROVEEDOR ..> PROVEEDOR_REF : evento/proyección
PROVEEDOR_REF ||--o{ MOVIMIENTO : origen recepción
PRODUCTO ..> PRODUCTO_REF : evento/proyección
PRODUCTO_REF ||--o{ LOTE
PRODUCTO_REF ||--o{ ACTIVO
PRODUCTO_REF ||--o{ EXISTENCIA
UBICACION ||--o{ UBICACION : jerarquía
UBICACION ||--o{ EXISTENCIA
LOTE ||--o{ EXISTENCIA
ACTIVO ||--o{ EXISTENCIA
MOVIMIENTO ||--|{ DETALLE_MOVIMIENTO
PRODUCTO_REF ||--o{ DETALLE_MOVIMIENTO
MOVIMIENTO ||--o{ AUTORIZACION
CONTEO_FISICO ||--|{ DETALLE_CONTEO
UBICACION ||--o{ CONTEO_FISICO

USUARIO ..> MOVIMIENTO : registra/solicita
USUARIO ..> AUTORIZACION : autoriza
USUARIO ..> EVIDENCIA : carga
USUARIO ..> AUDITORIA : actor
USUARIO ..> NOTIFICACION : recibe
MOVIMIENTO ..> EVIDENCIA : owner UUID
ACTIVO ..> EVIDENCIA : owner UUID
REPORTE ..> EVIDENCIA : owner UUID

PRODUCTO ..> PROYECCION_PRODUCTO : evento
EXISTENCIA ..> PROYECCION_INVENTARIO : evento
MOVIMIENTO ..> PROYECCION_MOVIMIENTO : evento
PROYECCION_INVENTARIO ..> KPI
PROYECCION_MOVIMIENTO ..> KPI
KPI ..> REPORTE

' --- NOTAS ---
note bottom
Las líneas punteadas entre bounded contexts son relaciones semánticas/eventuales.
No representan FK PostgreSQL cross-schema.
Outbox, idempotency y processed_event son conceptos técnicos y se muestran en DER lógicos/físicos.
end note
@enduml