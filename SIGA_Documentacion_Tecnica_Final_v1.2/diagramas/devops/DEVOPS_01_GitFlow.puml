@startuml DEVOPS_01_GitFlow

' ============================================================
' CONFIGURACIÓN VISUAL
' Fuente de verdad lógica: DEVOPS-01 original
' Esta sección modifica únicamente la presentación.
' ============================================================

!theme plain

skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam defaultFontColor #1E293B
skinparam dpi 300
skinparam padding 8

skinparam BackgroundColor #F8FAFC

' ============================================================
' FLECHAS Y TRANSICIONES
' ============================================================

skinparam ArrowColor #475569
skinparam ArrowThickness 1.5
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 11
skinparam ArrowFontStyle bold

' ============================================================
' INICIO Y FIN
' ============================================================

skinparam ActivityStartColor #0EA5E9
skinparam ActivityEndColor #64748B
skinparam ActivityBorderThickness 1.5

' ============================================================
' DECISIONES
' ============================================================

skinparam ActivityDiamondBackgroundColor #FEF3C7
skinparam ActivityDiamondBorderColor #D97706
skinparam ActivityDiamondFontColor #92400E
skinparam ActivityDiamondFontStyle bold

' ============================================================
' NOTAS
' ============================================================

skinparam NoteBackgroundColor #EFF6FF
skinparam NoteBorderColor #3B82F6
skinparam NoteFontColor #1E3A8A
skinparam NoteRoundCorner 10

' ============================================================
' ESTILOS SEMÁNTICOS PARA ACTIVIDADES
' ============================================================

<style>
activityDiagram {

  LineColor #334155
  FontColor #0F172A

  .jira {
    BackgroundColor #EFF6FF
    LineColor #2563EB
    FontColor #1E40AF
  }

  .git {
    BackgroundColor #F5F3FF
    LineColor #7C3AED
    FontColor #5B21B6
  }

  .ci {
    BackgroundColor #ECFEFF
    LineColor #0891B2
    FontColor #155E75
  }

  .success {
    BackgroundColor #ECFDF5
    LineColor #059669
    FontColor #065F46
  }

  .release {
    BackgroundColor #EEF2FF
    LineColor #4F46E5
    FontColor #3730A3
  }

  .error {
    BackgroundColor #FEF2F2
    LineColor #DC2626
    FontColor #991B1B
  }
}
</style>

' ============================================================
' TÍTULO
' ============================================================

title
<b><size:16><color:#1E293B>DEVOPS-01 — GitFlow Simplificado por Repositorio</color></size></b>
<size:11><color:#64748B>Estrategia de branching, integración continua y despliegues</color></size>
end title

' ============================================================
' FLUJO CANÓNICO
' ============================================================

start

:<color:#2563EB><&task></color> Crear issue/HU Jira SIGA-123; <<jira>>

:<color:#7C3AED><&git-branch></color> Crear branch feature/SIGA-123-... desde develop; <<git>>

:<color:#7C3AED><&pencil></color> Commits Conventional Commits; <<git>>

:<color:#7C3AED><&git-pull-request></color> Push + Pull Request a develop; <<git>>

:<color:#0891B2><&shield></color> CI: build/tests/quality/security; <<ci>>

if (CI + review aprobados?) then (sí)

  :<color:#059669><&check></color> Merge a develop; <<success>>

  :<color:#059669><&cog></color> Integración DEV; <<success>>

  if (Cierre de incremento/release?) then (sí)

    :<color:#4F46E5><&arrow-thick-right></color> PR develop -> main; <<release>>

    :<color:#4F46E5><&tag></color> Tag semver vX.Y.Z; <<release>>

    :<color:#4F46E5><&box></color> Build imagen inmutable + deploy QA/PROD; <<release>>

  endif

else (no)

  :<color:#DC2626><&warning></color> Corregir en feature; <<error>>

endif

stop

' ============================================================
' POLÍTICAS DEL REPOSITORIO
' ============================================================

note right
  <b>Políticas del Repositorio:</b>

  <b>main</b> y <b>develop</b> protegidas;
  sin push directo.

  <b>hotfix/*</b> nace de <b>main</b> y se sincroniza
  de vuelta a <b>develop</b>.
end note

@enduml