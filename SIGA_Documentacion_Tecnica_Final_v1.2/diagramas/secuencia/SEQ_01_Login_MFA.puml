@startuml
title SEQ-01 — Login + MFA TOTP

' --- Configuración visual (Skinparams) Mejorada ---
skinparam shadowing true
skinparam roundcorner 16
skinparam defaultFontName "Segoe UI", Helvetica, Arial, sans-serif
skinparam defaultFontSize 13
skinparam BackgroundColor #F8F9FA

' Ocultar las etiquetas de los estereotipos para mantener un diseño limpio
hide stereotype

' --- Estilos base para Secuencia ---
skinparam sequence {
  ArrowColor #34495E
  ArrowThickness 1.5
  LifeLineBorderColor #95A5A6
  LifeLineBackgroundColor #ECF0F1
  
  ParticipantBorderThickness 2
  ParticipantPadding 20
  
  ' Estilos de Grupos (alt/else) más elegantes
  GroupHeaderFontColor #2C3E50
  GroupHeaderBackgroundColor #EAECEE
  GroupBorderColor #ABB2B9
  GroupBorderThickness 1.5
  GroupBackgroundColor #FFFFFF
}

' --- Paleta de Colores Diferenciada por Componente ---
skinparam actor {
  BackgroundColor<<User>> #FDEDEC
  BorderColor<<User>> #E74C3C
  FontColor<<User>> #C0392B
}
skinparam participant {
  BackgroundColor<<Client>> #EAFAF1
  BorderColor<<Client>> #2ECC71
  FontColor<<Client>> #27AE60

  BackgroundColor<<Gateway>> #FEF9E7
  BorderColor<<Gateway>> #F1C40F
  FontColor<<Gateway>> #D4AC0D

  BackgroundColor<<IAM>> #EBF5FB
  BorderColor<<IAM>> #3498DB
  FontColor<<IAM>> #2980B9
}
skinparam database {
  BackgroundColor<<RDBMS>> #F4ECF7
  BorderColor<<RDBMS>> #9B59B6
  FontColor<<RDBMS>> #8E44AD

  BackgroundColor<<Cache>> #FDEBD0
  BorderColor<<Cache>> #E67E22
  FontColor<<Cache>> #D35400
}

' --- Declaración de Participantes con Iconos y Estereotipos ---
actor "<size:18><&person></size>\nUsuario" as Usuario <<User>>
participant "<size:18><&phone></size>\nWeb/Mobile" as C <<Client>>
participant "<size:18><&bolt></size>\nAPI Gateway" as G <<Gateway>>
participant "<size:18><&shield></size>\nMS-IAM" as I <<IAM>>
database "<size:18><&hard-drive></size>\niam schema" as DB <<RDBMS>>
database "<size:18><&layers></size>\nRedis" as Redis <<Cache>>

' --- Lógica y Contenido Original ---
Usuario -> C : usuario + contraseña
C -> G : POST /api/v1/auth/login
G -> I : forward + correlationId
I -> DB : cargar usuario/roles/MFA
I -> I : Argon2id.verify()
I -> Redis : registrar intento/rate limit
alt credenciales inválidas/bloqueado
 I --> G : Problem 401/429
 G --> C : error seguro
else válidas y MFA requerido
 I --> G : 202 MFA_REQUIRED + challengeId
 G --> C : challenge
 Usuario -> C : TOTP
 C -> G : POST /api/v1/auth/mfa/verify
 G -> I : challenge + TOTP
 I -> I : RFC6238 verify (30s ±1)
 alt OTP inválido
  I --> C : 401/429
 else OTP válido
  I -> DB : crear refresh session/rotation family
  I --> C : access JWT RS256 (30m) + refresh seguro
 end
end
@enduml