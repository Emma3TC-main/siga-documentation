' ============================================================
' DIAGRAMA (CONTENIDO INMUTABLE)
' ============================================================
title <size:18><color:#0F172A><b>C4-02 — Contenedores: baseline Docker Compose sobre GCP</b></color></size>
left to right direction

actor Usuario

node "Internet" as NET <<Network>>

node "GCP Compute Engine / Linux VM" as VM {
  rectangle "Nginx\nTLS termination" as NGINX <<Proxy>>
  rectangle "Web React/TS" as WEB <<Web>>
  rectangle "Spring Cloud Gateway" as GW <<Gateway>>
  
  package "Microservicios Java 21 / Spring Boot" {
    rectangle "MS-IAM" as IAM <<Microservice>>
    rectangle "MS-CAT" as CAT <<Microservice>>
    rectangle "MS-INV\nInventory + Movement" as INV <<Microservice>>
    rectangle "MS-EVI" as EVI <<Microservice>>
    rectangle "MS-AUD" as AUD <<Microservice>>
    rectangle "MS-REP" as REP <<Microservice>>
  }
  
  queue "RabbitMQ" as RMQ
  database "Redis" as REDIS
  
  rectangle "Prometheus" as PROM <<Observability>>
  rectangle "Grafana" as GRAF <<Observability>>
  rectangle "Loki" as LOKI <<Observability>>
  rectangle "Jaeger (DEV/QA)" as JAEGER <<Observability>>
}

database "Cloud SQL PostgreSQL\n(schemas por servicio)" as PG
cloud "Google Cloud Storage" as GCS
cloud "Artifact Registry" as AR
cloud "Secret Manager" as SM

Usuario --> NGINX : HTTPS 443
NGINX --> WEB : SPA
NGINX --> GW : /api/*
GW --> IAM
GW --> CAT
GW --> INV
GW --> EVI
GW --> AUD
GW --> REP

IAM --> PG : iam schema
CAT --> PG : catalog schema
INV --> PG : inventory schema
EVI --> PG : evidence schema
AUD --> PG : audit schema
REP --> PG : analytics schema

IAM --> REDIS : OTP/revocación/rate limit
CAT --> REDIS : caché opcional
REP --> REDIS : caché breve dashboard

CAT --> RMQ : eventos de catálogo
INV --> RMQ : outbox publisher
EVI --> RMQ : eventos de evidencia
RMQ --> AUD
RMQ --> REP

EVI --> GCS : objetos
REP --> GCS : reportes persistentes

PROM --> IAM : scrape
PROM --> CAT : scrape
PROM --> INV : scrape
PROM --> EVI : scrape
PROM --> AUD : scrape
PROM --> REP : scrape
PROM --> GRAF
LOKI --> GRAF
JAEGER --> GRAF : enlace/consulta

AR ..> VM : imágenes versionadas
SM ..> VM : secretos runtime

note right of INV
  <b>Único núcleo transaccional para stock + movimiento.</b>
  No existe movement-service independiente.
end note

@enduml