!theme plain

skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName "Segoe UI", "Helvetica Neue", Arial, sans-serif
skinparam defaultFontSize 13
skinparam dpi 300
skinparam padding 10
skinparam nodesep 60
skinparam ranksep 90
skinparam textalignment center

skinparam BackgroundColor #FFFFFF

' ============================================================
' ESTILOS DE LÍNEAS Y FLECHAS
' ============================================================
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.5
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 12
skinparam ArrowFontStyle bold

' ============================================================
' ESTILOS DE COMPONENTES POR TIPO (ESTEREOTIPOS VISUALES)
' ============================================================
skinparam actor {
  BackgroundColor #F8FAFC
  BorderColor #475569
  BorderThickness 1.5
  FontColor #0F172A
}

skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  BorderThickness 2
  FontColor #0F172A
  FontSize 14
  FontStyle bold
}

skinparam node<<Network>> {
  BackgroundColor #F1F5F9
  BorderColor #94A3B8
  BorderThickness 1.5
  FontColor #475569
  BorderStyle dashed
}

skinparam package {
  BackgroundColor #F1F5F9
  BorderColor #94A3B8
  BorderThickness 1.5
  FontColor #334155
  FontSize 13
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  BorderThickness 1.5
  FontColor #0F172A
}

skinparam rectangle<<Proxy>> {
  BackgroundColor #F1F5F9
  BorderColor #475569
}

skinparam rectangle<<Web>> {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}

skinparam rectangle<<Gateway>> {
  BackgroundColor #FDF2F8
  BorderColor #DB2777
}

skinparam rectangle<<Microservice>> {
  BackgroundColor #E0F2FE
  BorderColor #0284C7
}

skinparam rectangle<<Observability>> {
  BackgroundColor #F8FAFC
  BorderColor #475569
  BorderStyle dotted
}

skinparam database {
  BackgroundColor #FFFBEB
  BorderColor #D97706
  BorderThickness 1.5
  FontColor #0F172A
}

skinparam queue {
  BackgroundColor #FAF5FF
  BorderColor #9333EA
  BorderThickness 1.5
  FontColor #0F172A
}

