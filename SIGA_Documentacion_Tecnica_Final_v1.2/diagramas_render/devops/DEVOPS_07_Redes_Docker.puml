' ============================================================
' TÍTULO
' ============================================================

title
<b><size:16><color:#1E293B>DEVOPS-07 — Segmentación lógica de redes Docker</color></size></b>
<size:11><color:#64748B>Separación de redes y mínimo privilegio de conectividad</color></size>
end title

' ============================================================
' ARQUITECTURA DE RED
' ============================================================

cloud "<b>Internet</b>\n<size:10><color:#3730A3><&globe> Red externa</color></size>" as Internet

package "<b>edge-network</b>\n<size:10><color:#334155>Entrada y enrutamiento</color></size>" as EDGE <<edge>> {

    rectangle "<b>Nginx</b>\n<size:10><color:#1E293B><&globe> Reverse Proxy</color></size>" as Nginx <<edgeComponent>>

    rectangle "<b>Web</b>\n<size:10><color:#1E293B><&browser> Frontend</color></size>" as Web <<edgeComponent>>

    rectangle "<b>Gateway</b>\n<size:10><color:#1E293B><&transfer> API Gateway</color></size>" as Gateway <<edgeComponent>>
}

package "<b>backend-network</b>\n<size:10><color:#5B21B6>Lógica de negocio</color></size>" as BACKEND <<backend>> {

    rectangle "<b>Microservices</b>\n<size:10><color:#5B21B6><&layers> Servicios</color></size>" as MS <<backendComponent>>

    queue "<b>RabbitMQ</b>\n<size:10><color:#92400E><&envelope-closed> Mensajería</color></size>" as RabbitMQ
}

package "<b>data-network</b>\n<size:10><color:#155E75>Persistencia</color></size>" as DATA <<data>> {

    database "<b>PostgreSQL/Cloud connector</b>\n<size:10><color:#155E75><&hard-drive> Base de datos</color></size>" as PG

    database "<b>Redis</b>\n<size:10><color:#155E75><&bolt> Cache</color></size>" as Redis
}

package "<b>observability-network</b>\n<size:10><color:#5B21B6>Monitoreo</color></size>" as OBSNET <<observability>> {

    rectangle "<b>Prometheus</b>\n<size:10><color:#5B21B6><&dashboard> Métricas</color></size>" as Prometheus <<observabilityComponent>>

    rectangle "<b>Grafana</b>\n<size:10><color:#5B21B6><&monitor> Visualización</color></size>" as Grafana <<observabilityComponent>>

    rectangle "<b>Loki</b>\n<size:10><color:#5B21B6><&file> Logs</color></size>" as Loki <<observabilityComponent>>
}

' ============================================================
' RELACIONES — FUENTE DE VERDAD
' ============================================================

Internet --> Nginx : 443

Nginx --> Web

Nginx --> Gateway

Gateway --> MS

MS --> PG

MS --> Redis

MS --> RabbitMQ

Prometheus ..> MS

Loki ..> MS

Grafana --> Prometheus

Grafana --> Loki

' ============================================================
' NOTA — FUENTE DE VERDAD
' ============================================================

note bottom
  <b>Prohibido:</b> Internet -> PG/Redis/RabbitMQ;
  React -> DB; un microservicio -> schema ajeno por SQL.

  Las redes de Compose limitan conectividad al mínimo requerido.
end note

@enduml