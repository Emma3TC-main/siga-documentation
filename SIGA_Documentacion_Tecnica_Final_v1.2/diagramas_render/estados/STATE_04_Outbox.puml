@startuml
' @DERIVADO_VISUAL_META_BEGIN
' SIGA v1.2 — DERIVADO VISUAL / RENDER ONLY / NO CANÓNICO
' Fuente canónica: diagramas/estados/STATE_04_Outbox.puml
' Uso: informe, Word, sustentación y exportación PNG/SVG.
' Prohibido usar como fuente de implementación, requisitos o contexto de agentes/IA.
' Generado por: tools/generar_derivados_visuales.py
' @DERIVADO_VISUAL_META_END

' ============================================================
' ESTILOS GENERALES — STATE DIAGRAM SIGA
' ============================================================

!theme plain

' --- Renderizado y geometría general ---
skinparam dpi 300
skinparam shadowing false
skinparam roundcorner 10
skinparam padding 6
skinparam nodesep 55
skinparam ranksep 45

' --- Tipografía general ---
skinparam defaultFontName "Inter", "Segoe UI", "Helvetica", Arial, sans-serif
skinparam defaultFontSize 12
skinparam defaultFontColor #1E293B

' --- Fondo ---
skinparam BackgroundColor #FFFFFF

' ============================================================
' TÍTULO
' ============================================================

skinparam title {
    FontSize 15
    FontStyle bold
    FontColor #0F172A
    BorderColor transparent
    BackgroundColor transparent
}

' ============================================================
' TRANSICIONES / FLECHAS
' ============================================================

skinparam ArrowColor #64748B
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2

' ============================================================
' ESTADOS — ESTILO BASE
' ============================================================

skinparam state {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 12
    FontStyle bold

    StartColor #0EA5E9
    EndColor #64748B
}

' ============================================================
' ESTADOS — PALETA SEMÁNTICA
' ============================================================

' Estado inicial / borrador
skinparam state<<draft>> {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    FontColor #1D4ED8
}

' Estado pendiente / espera
skinparam state<<pending>> {
    BackgroundColor #FFFBEB
    BorderColor #F59E0B
    FontColor #B45309
}

' Estado autorizado / validado
skinparam state<<authorized>> {
    BackgroundColor #EEF2FF
    BorderColor #6366F1
    FontColor #4338CA
}

' Estado exitoso / confirmado
skinparam state<<success>> {
    BackgroundColor #ECFDF5
    BorderColor #10B981
    FontColor #047857
}

' Estado cancelado / neutral
skinparam state<<cancelled>> {
    BackgroundColor #F1F5F9
    BorderColor #94A3B8
    FontColor #64748B
}

' Estado rechazado / error
skinparam state<<rejected>> {
    BackgroundColor #FEF2F2
    BorderColor #EF4444
    FontColor #B91C1C
}

' ============================================================
' NOTAS
' ============================================================

skinparam Note {
    BackgroundColor #FEFCE8
    BorderColor #FACC15
    BorderThickness 1
    FontColor #713F12
    FontSize 11
    RoundCorner 8
}

' ============================================================
' LÓGICA DEL DIAGRAMA
' ============================================================

title STATE-04 — Ciclo de Outbox Event

' Asignación de estereotipos para paleta de colores
state PENDING <<pending>>
state PUBLISHING <<authorized>>
state PUBLISHED <<success>>
state DEAD <<rejected>>

[*] --> PENDING : insertado en transacción de dominio
PENDING --> PUBLISHING : worker adquiere lote
PUBLISHING --> PUBLISHED : publisher confirm
PUBLISHING --> PENDING : error transitorio / retry
PENDING --> DEAD : intentos agotados / política
PUBLISHED --> [*]
DEAD --> [*] : intervención / replay controlado

note right of PENDING
El commit de negocio no depende de que RabbitMQ esté disponible en ese instante.
El evento ya existe durablemente en PostgreSQL y se reintenta.
end note

@enduml