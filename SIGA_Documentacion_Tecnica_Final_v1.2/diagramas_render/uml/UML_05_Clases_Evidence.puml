enum EvidenceOwnerType {
 MOVEMENT
 ASSET
 ADJUSTMENT
 REPORT
}

class EvidenceMetadata {
 UUID id
 EvidenceOwnerType ownerType
 UUID ownerId
 String objectKey
 String originalFilename
 String contentType
 long sizeBytes
 String sha256
 StorageProvider storageProvider
 UUID uploadedByUserId
 EvidenceState status
 jsonb metadata
 Instant uploadedAt
}

interface ObjectStoragePort {
 store()
 read()
 delete()
 signedUrl()
}

class MinioStorageAdapter
class GcsStorageAdapter

class EvidenceOutboxEvent {
 UUID id
 String eventType
 UUID aggregateId
 jsonb payload
 OutboxState status
}

ObjectStoragePort <|.. MinioStorageAdapter
ObjectStoragePort <|.. GcsStorageAdapter
EvidenceMetadata ..> ObjectStoragePort
EvidenceMetadata ..> EvidenceOutboxEvent : EvidenceUploaded

note right of EvidenceMetadata
ownerId es referencia UUID externa sin FK cross-schema.
El binario vive en object storage privado; 
PostgreSQL conserva integridad y metadata.
end note
